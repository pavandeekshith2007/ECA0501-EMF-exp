clc;
clear;

// Constants
e = 8.854e-12; // permittivity of free space

// Inputs
a1 = input("Enter the a1 value is:");
d  = input("Enter the d value is:");

// Case 1: Single dielectric
c1 = e * a1 / d;
disp(c1);

// Inputs for layered dielectric
a2  = input("Enter the a2 value is:");
d1  = input("Enter the d1 value is:");
d2  = input("Enter the d2 value is:");
d3  = input("Enter the d3 value is:");
er1 = input("Enter the er1 value is:");
er2 = input("Enter the er2 value is:");
er3 = input("Enter the er3 value is:");

// Case 2: Three dielectric layers in series
c2 = (e * a2) / ( (d1/er1) + (d2/er2) + (d3/er3) );
disp(c2);
