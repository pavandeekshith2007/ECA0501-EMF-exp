clc;
rho0 = 3e-6;
epsilon = 8.854e-12;
R = 2;
n = 200;
r = linspace(0, 4, n);
D = zeros(1, n); 
E = zeros(1, n); 
Q_total = rho0 * (4 * %pi * R^3 / 3); 
for i = 1:n 
    ri = r(i);
    if ri < R then 
        Q_enclosed = rho0 * (4 * %pi * ri^3 / 3); 
    else 
        Q_enclosed = Q_total; 
    end 
    D(i) = Q_enclosed / (4 * %pi * ri^2); 
    E(i) = D(i) / epsilon; 
end 
subplot(1, 2, 1); 
plot(r, D, "r"); 
xlabel("Radius (m)"); 
ylabel("Electric Flux Density (D) [C/m^2]"); 
title("Uniform Charge Density: D vs. Radius"); 
subplot(1, 2, 2); 
plot(r, E, "b"); 
xlabel("Radius (m)"); 
ylabel("Electric Field (E) [V/m]"); 
title("Uniform Charge Density: E vs. Radius"); 
