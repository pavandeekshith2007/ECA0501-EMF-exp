epsilon0 = 8.854e-12; 
k = 1 / (4 * %pi * epsilon0);
q = 1e-6; 
r1_case1 = 1; 
r2_case1 = linspace(1.1, 10, 100); 
deltaV_case1 = k * q * (1 / r1_case1 - 1 ./ r2_case1);  
clf(); 
subplot(3, 1, 1); 
plot(r2_case1, deltaV_case1, "r"); 
xlabel("r2 (m)"); 
ylabel("Delta V (V)"); 
title("Case 1: Positive Charge, Fixed r1");
