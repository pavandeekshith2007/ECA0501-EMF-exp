clc;
clear;

// Constants
epsilon0 = 8.854e-12;
pi = %pi;   // use Scilab’s built-in pi

// Input
q  = input("Enter the q value: ");
ax = input("Enter the value of ax= ");
ay = input("Enter the value of ay= ");
bx = input("Enter the value of bx= ");
by = input("Enter the value of by= ");

// Distances
r1 = sqrt(ax^2 + ay^2);
r2 = sqrt(bx^2 + by^2);

// Potentials
v1 = q / (4 * pi * epsilon0 * r1);
v2 = q / (4 * pi * epsilon0 * r2);

// Potential difference
dv = v1 - v2;

// Output
disp("The value of v1 = " + string(v1));
disp("The value of v2 = " + string(v2));
disp("The electric potential difference = " + string(dv));

// Plotting
r = linspace(0, 10, 50);
y = v1 * exp(-0.1 * r);
z = v2 * exp(-0.1 * r);
x = dv * exp(-0.1 * r);

figure();
subplot(2,2,1);
plot(r, y);
xlabel("Radius 1");
ylabel("Voltage 1");
title("Potential V1");

subplot(2,2,2);
plot(r, z);
xlabel("Radius 2");
ylabel("Voltage 2");
title("Potential V2");

subplot(2,2,3);
plot(r, x);
xlabel("Radius");
ylabel("Voltage Difference");
title("Potential Difference ΔV");
