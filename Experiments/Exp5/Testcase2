clc;
clear;

// Constants
epsilon0 = 8.854e-12;
k = 1 / (4 * %pi * epsilon0);

// Case 2: Negative charge, r1 fixed, r2 varies
q_case2 = -1e-6;          // -1 µC
r1_case2 = 1;             // meters
r2_case2 = linspace(1.1, 10, 100); // meters

// Potential difference
deltaV_case2 = k * q_case2 * (1/r1_case2 - 1 ./ r2_case2);

// Plotting
clf();
subplot(3,1,2);
plot(r2_case2, deltaV_case2, "b");
xlabel("r2 (m)");
ylabel("Delta V (V)");
title("Case 2: Negative Charge, Fixed r1");
