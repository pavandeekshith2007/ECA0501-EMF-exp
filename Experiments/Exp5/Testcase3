clc;
clear;

// Constants
epsilon0 = 8.854e-12;
k = 1 / (4 * %pi * epsilon0);

// Case 3: Positive charge, both r1 and r2 vary
q = 1e-6;                          // +1 µC
r1_case3 = linspace(0.5, 5, 100);  // meters
r2_case3 = linspace(5, 10, 100);   // meters

// Potential difference (element-wise)
deltaV_case3 = k * q * (1 ./ r1_case3 - 1 ./ r2_case3);

// Plotting
clf();
subplot(3,1,3);
plot(r1_case3, deltaV_case3, "g");
xlabel("r1 (m)");
ylabel("Delta V (V)");
title("Case 3: Positive Charge, Both r1 and r2 Vary");
