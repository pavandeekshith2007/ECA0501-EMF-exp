clc;
clear;
charge_1 = input("Enter the charge_1 value = ");
charge_2 = input("Enter the charge_2 value = ");
radius   = input("Enter the radius value (m) = ");
current_1 = input("Enter the current_1 value = ");
current_2 = input("Enter the current_2 value = ");
l = input("Enter the length value (m) = ");
d = input("Enter the distance value (m) = ");
epsilon = 8.854e-12;
mu = 4 * %pi * 1e-7;
F = (charge_1 * charge_2) / (4 * %pi * epsilon * radius^2);
f = (mu * current_1 * current_2 * l) / (2 * %pi * d);
disp("THE FORCE BETWEEN TWO ELECTRIC CHARGES");
disp(F);
disp("THE FORCE BETWEEN TWO PARALLEL CONDUCTORS");
disp(f);
x = linspace(0.01, 0.1, 50);
y = (charge_1 * charge_2) ./ (4 * %pi * epsilon * x.^2);
z = (mu * current_1 * current_2 * l) ./ (2 * %pi * (1:50));
figure();
subplot(2,2,1);
plot(x, y);
xlabel("Radius (m)");
ylabel("Force (N)");
title("FORCE BETWEEN TWO ELECTRIC CHARGES");
subplot(2,2,2);
plot(1:50, z);
xlabel("Distance (m)");
ylabel("Force (N)");
title("FORCE BETWEEN TWO PARALLEL CONDUCTORS");
