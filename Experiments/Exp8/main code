clc; 
clear; 
r1=input("Enter the value of radius1="); 
r2=input("Enter the value of radius2="); 
er=input("Enter the value of er="); 
 
r=r2/r1; 
e0=8.854*10^-12; 
pi=3.14; 
e=e0*er; 
 
c=(2*pi*e)/(log(r)); 
disp('THE INNER AND OUTER RADIUS OF COAXIL CABLE=',[c]); 
 
x=linspace(0, 10, 50); 
y=c*exp(-0.1*x); 
 
figure(); 
subplot(1, 1, 1); 
plot2d3(x,y); 
xlabel("R"); 
ylabel("Capacitance"); 
title("INNER AND OUTER RADIUS");
